# Copy this file to .env.local and fill in your values
# Get these from your Supabase project settings

# Supabase - Public (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase - Server-side only (NEVER expose to client)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

# Postgres - Direct connection
POSTGRES_URL="postgres://..."
POSTGRES_PRISMA_URL="postgres://..."
POSTGRES_URL_NON_POOLING="postgres://..."
POSTGRES_HOST="db.your-project.supabase.co"
POSTGRES_DATABASE="postgres"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your-password"

# =============================================================================
# Photo Pipeline (002-photo-pipeline)
# =============================================================================

# Trigger.dev - Background job processing
TRIGGER_SECRET_KEY="tr_dev_xxx"
TRIGGER_API_URL="https://api.trigger.dev"

# Replicate - ML inference
REPLICATE_API_TOKEN="r8_xxx"

# MegaDetector model (deployed to Replicate)
MEGADETECTOR_MODEL_VERSION="your-username/megadetector:version-hash"

# Re-ID embedding model
EMBEDDING_MODEL_VERSION="your-username/deer-embedding:version-hash"
