# Copy this file to .env.local and fill in your values
# Get these from your Supabase project settings

# Supabase - Public (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase - Server-side only (NEVER expose to client)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

# Postgres - Direct connection
POSTGRES_URL="postgres://..."
POSTGRES_PRISMA_URL="postgres://..."
POSTGRES_URL_NON_POOLING="postgres://..."
POSTGRES_HOST="db.your-project.supabase.co"
POSTGRES_DATABASE="postgres"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your-password"

# =============================================================================
# Background Jobs & AI
# =============================================================================

# Trigger.dev - Background job processing
TRIGGER_SECRET_KEY="tr_dev_xxx"
TRIGGER_API_URL="https://api.trigger.dev"

# Shared queue for paid Gemini tasks. Defaults cap 10 jobs x 2 crop calls = 20.
# Tune from AI Studio project/model RPM and TPM, not API-key count.
# Legacy TRIGGER_CONCURRENCY_LIMIT remains accepted, capped at 20.
GEMINI_JOB_CONCURRENCY=10
GEMINI_CROP_CONCURRENCY=2
TRIGGER_BATCH_RATE=20

# Google Gemini API - AI analysis and deer identification
GEMINI_API_KEY="your-gemini-api-key"
# Existing calibrated model; check Google model availability for your project.
GEMINI_MODEL="gemini-2.5-flash"
# Optional ONE supported fallback. Retired Gemini 1.5/2.0 are rejected.
GEMINI_FALLBACK_MODELS=""
# Detailed antler fingerprint extraction (independent of GEMINI_MODEL)
GEMINI_FINGERPRINT_MODEL="gemini-3.8-flash"
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_ATTEMPTS=3

# =============================================================================
# Maps
# =============================================================================

# Google Maps - Map display for location picker
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
